---
import linksdata from "../data/links.json";
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../i18n/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<article class="links">
  <h3 class="font-bold my-2">{t("references.title")}</h3>
  <ul class="flex flex-col gap-4">
    {
      linksdata
        .filter((item) => item.active)
        .map((item, index) => {
          if (item.internal) {
            return (
              <li class="bg-bgsecondary p-4 rounded-md">
                <a href={`${lang == "es" ? "/es" : ""}${item.target}`}>
                  <img
                    src={`/images/banners/${item.name}`}
                    alt={item.title}
                    class="w-full"
                  />
                </a>
              </li>
            );
          } else {
            return (
              <li class="bg-bgsecondary p-4 rounded-md">
                <a target="_blank" href={item.target}>
                  <img
                    src={`/images/banners/${item.name}`}
                    alt={item.title}
                    class="w-full"
                  />
                </a>
              </li>
            );
          }
        })
    }
  </ul>
</article>
